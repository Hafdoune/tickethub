{% extends 'base.html.twig' %}

{% block title %}Tableau de bord · TicketHub{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ vite_entry_link_tags('dashboard') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
