{% extends 'base.html.twig' %}

{% block title %}Nouveau ticket · TicketHub{% endblock %}

{% block body %}
    <div class="mx-auto max-w-2xl">
        <twig:Card>
            <twig:Card:Header>
                <twig:Card:Title class="text-xl">Nouveau ticket</twig:Card:Title>
                <twig:Card:Description>Décrivez votre problème, un agent vous répondra rapidement.</twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content>
                {{ include('ticket/_form.html.twig', {button_label: 'Envoyer le ticket'}) }}
            </twig:Card:Content>
        </twig:Card>
    </div>
{% endblock %}
