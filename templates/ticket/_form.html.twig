{{ form_start(form, {attr: {class: 'grid gap-5'}}) }}
    {{ form_row(form.title) }}
    <div class="grid gap-5 md:grid-cols-2">
        {{ form_row(form.category) }}
        {{ form_row(form.priority) }}
    </div>
    {{ form_row(form.description) }}
    <div>
        <twig:Button type="submit">{{ button_label }}</twig:Button>
    </div>
{{ form_end(form) }}
