{% extends 'base.html.twig' %}

{% block title %}Modifier le ticket #{{ ticket.id }} · TicketHub{% endblock %}

{% block body %}
    <div class="mx-auto max-w-2xl">
        <a href="{{ path('ticket_show', {id: ticket.id}) }}" class="text-sm text-muted-foreground hover:text-foreground">← Retour au ticket</a>
        <twig:Card class="mt-3">
            <twig:Card:Header>
                <twig:Card:Title class="text-xl">Modifier le ticket #{{ ticket.id }}</twig:Card:Title>
            </twig:Card:Header>
            <twig:Card:Content>
                {{ include('ticket/_form.html.twig', {button_label: 'Enregistrer'}) }}
            </twig:Card:Content>
        </twig:Card>
    </div>
{% endblock %}
