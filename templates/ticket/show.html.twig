{% extends 'base.html.twig' %}

{% block title %}#{{ ticket.id }} {{ ticket.title }} · TicketHub{% endblock %}

{% block body %}
    <a href="{{ path('ticket_index') }}" class="text-sm text-muted-foreground hover:text-foreground">← Tous les tickets</a>

    <div class="mt-3 mb-6 flex flex-wrap items-center gap-2" data-ticket-header>
        <h1 class="mr-2 text-2xl font-semibold tracking-tight">#{{ ticket.id }} · {{ ticket.title }}</h1>
        <twig:StatusBadge :status="ticket.status" />
        <twig:PriorityBadge :priority="ticket.priority" />
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
        <div class="space-y-6 lg:col-span-2">
            <twig:Card>
                <twig:Card:Header class="pb-3">
                    <twig:Card:Description>{{ ticket.author }} · {{ ticket.createdAt|date('d/m/Y à H:i') }}</twig:Card:Description>
                </twig:Card:Header>
                <twig:Card:Content class="text-sm leading-relaxed">{{ ticket.description|nl2br }}</twig:Card:Content>
            </twig:Card>

            <twig:Card>
                <twig:Card:Header>
                    <twig:Card:Title>Échanges ({{ ticket.comments|length }})</twig:Card:Title>
                </twig:Card:Header>
                <twig:Card:Content class="divide-y">
                    {% for comment in ticket.comments %}
                        <div class="py-4 first:pt-0 {{ comment.author.isAgent ? 'border-l-2 border-l-primary pl-4' : '' }}" id="comment-{{ comment.id }}" data-comment>
                            <div class="mb-1 flex items-center gap-2 text-sm">
                                <span class="font-medium">{{ comment.author }}</span>
                                {% if comment.author.isAgent %}<twig:Badge variant="secondary">Support</twig:Badge>{% endif %}
                                <span class="text-muted-foreground">· {{ comment.createdAt|date('d/m/Y H:i') }}</span>
                            </div>
                            <p class="text-sm leading-relaxed">{{ comment.content|nl2br }}</p>
                        </div>
                    {% else %}
                        <p class="text-sm text-muted-foreground">Aucun échange pour l'instant.</p>
                    {% endfor %}
                </twig:Card:Content>
            </twig:Card>

            {% if comment_form %}
                <twig:Card>
                    <twig:Card:Content class="pt-6">
                        {{ form_start(comment_form, {attr: {class: 'grid gap-3'}}) }}
                            {{ form_widget(comment_form.content) }}
                            {{ form_errors(comment_form.content) }}
                            <div><twig:Button type="submit">Répondre</twig:Button></div>
                        {{ form_end(comment_form) }}
                    </twig:Card:Content>
                </twig:Card>
            {% elseif ticket.closed %}
                <twig:Alert>
                    <twig:Alert:Description>Ce ticket est fermé.</twig:Alert:Description>
                </twig:Alert>
            {% endif %}
        </div>

        <div class="space-y-6">
            <twig:Card>
                <twig:Card:Content class="pt-6">
                    <dl class="grid gap-3 text-sm">
                        <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Catégorie</dt><dd>{{ ticket.category }}</dd></div>
                        <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Client</dt><dd>{{ ticket.author }}</dd></div>
                        <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Agent</dt><dd>{{ ticket.assignee ?? 'Non assigné' }}</dd></div>
                        <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Mis à jour</dt><dd>{{ ticket.updatedAt|date('d/m/Y H:i') }}</dd></div>
                        {% if ticket.closedAt %}
                            <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Fermé le</dt><dd>{{ ticket.closedAt|date('d/m/Y H:i') }}</dd></div>
                        {% endif %}
                    </dl>
                </twig:Card:Content>
            </twig:Card>

            {% if manage_form %}
                <twig:Card>
                    <twig:Card:Header>
                        <twig:Card:Title>Traitement</twig:Card:Title>
                    </twig:Card:Header>
                    <twig:Card:Content>
                        {{ form_start(manage_form, {attr: {class: 'grid gap-4'}}) }}
                            {{ form_row(manage_form.status) }}
                            {{ form_row(manage_form.assignee) }}
                            <twig:Button type="submit" class="w-full">Mettre à jour</twig:Button>
                        {{ form_end(manage_form) }}
                    </twig:Card:Content>
                </twig:Card>
            {% endif %}

            <div class="grid gap-2">
                {% if is_granted('TICKET_EDIT', ticket) %}
                    <twig:Button as="a" href="{{ path('ticket_edit', {id: ticket.id}) }}" variant="outline" size="lg">Modifier</twig:Button>
                {% endif %}
                {% if is_granted('TICKET_CLOSE', ticket) %}
                    <form method="post" action="{{ path('ticket_close', {id: ticket.id}) }}" onsubmit="return confirm('Fermer ce ticket ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('close-ticket-' ~ ticket.id) }}">
                        <twig:Button type="submit" variant="destructive" size="lg" class="w-full">Fermer le ticket</twig:Button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
