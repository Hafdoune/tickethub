{% extends 'base.html.twig' %}
{% import 'ticket/_badges.html.twig' as badges %}

{% block title %}Tickets · TicketHub{% endblock %}

{% block body %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="h3 mb-0">{{ is_granted('ROLE_AGENT') ? 'Tous les tickets' : 'Mes tickets' }}</h1>
        <span class="text-secondary small">{{ tickets|length }} ticket(s)</span>
    </div>

    <form class="row g-2 mb-3" method="get">
        <div class="col-md-5">
            <input type="search" name="q" value="{{ app.request.query.get('q') }}" class="form-control" placeholder="Rechercher un ticket">
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">Tous les statuts</option>
                {% for s in enum('App\\Enum\\TicketStatus').cases() %}
                    <option value="{{ s.value }}" {{ app.request.query.get('status') == s.value ? 'selected' }}>{{ s.label }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2">
            <select name="priority" class="form-select">
                <option value="">Priorité</option>
                {% for p in enum('App\\Enum\\TicketPriority').cases() %}
                    <option value="{{ p.value }}" {{ app.request.query.get('priority') == p.value ? 'selected' }}>{{ p.label }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button class="btn btn-outline-dark" type="submit">Filtrer</button>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Sujet</th>
                        <th>Catégorie</th>
                        <th>Priorité</th>
                        <th>Statut</th>
                        {% if is_granted('ROLE_AGENT') %}<th>Client</th><th>Agent</th>{% endif %}
                        <th>Créé le</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ticket in tickets %}
                        <tr class="ticket-row">
                            <td class="text-secondary">{{ ticket.id }}</td>
                            <td>{{ ticket.title }}</td>
                            <td>{{ ticket.category }}</td>
                            <td>{{ badges.priority(ticket.priority) }}</td>
                            <td>{{ badges.status(ticket.status) }}</td>
                            {% if is_granted('ROLE_AGENT') %}
                                <td>{{ ticket.author }}</td>
                                <td>{{ ticket.assignee ?? '—' }}</td>
                            {% endif %}
                            <td class="text-nowrap">{{ ticket.createdAt|date('d/m/Y H:i') }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="8" class="text-center text-secondary py-4">Aucun ticket.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if pages > 1 %}
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                {% for p in 1..pages %}
                    <li class="page-item {{ p == page ? 'active' }}">
                        <a class="page-link" href="{{ path('ticket_index', app.request.query.all|merge({page: p})) }}">{{ p }}</a>
                    </li>
                {% endfor %}
            </ul>
        </nav>
    {% endif %}
{% endblock %}
