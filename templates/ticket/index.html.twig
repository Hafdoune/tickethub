{% extends 'base.html.twig' %}

{% block title %}Tickets · TicketHub{% endblock %}

{% block body %}
    {% set is_agent = is_granted('ROLE_AGENT') %}
    {% set query = app.request.query %}

    <div class="mb-6 flex flex-wrap items-end justify-between gap-2">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">{{ is_agent ? 'Tous les tickets' : 'Mes tickets' }}</h1>
            <p class="text-sm text-muted-foreground">{{ tickets|length }} ticket(s)</p>
        </div>
    </div>

    <form method="get" class="mb-4 grid gap-2 md:grid-cols-[1fr_200px_160px_auto]">
        <twig:Input type="search" name="q" value="{{ query.get('q') }}" placeholder="Rechercher un ticket" class="h-9" />
        <twig:Select name="status" class="h-9">
            <option value="">Tous les statuts</option>
            {% for s in enum('App\\Enum\\TicketStatus').cases() %}
                <option value="{{ s.value }}" {{ query.get('status') == s.value ? 'selected' }}>{{ s.label }}</option>
            {% endfor %}
        </twig:Select>
        <twig:Select name="priority" class="h-9">
            <option value="">Priorité</option>
            {% for p in enum('App\\Enum\\TicketPriority').cases() %}
                <option value="{{ p.value }}" {{ query.get('priority') == p.value ? 'selected' }}>{{ p.label }}</option>
            {% endfor %}
        </twig:Select>
        <twig:Button type="submit" variant="outline" size="lg">Filtrer</twig:Button>
    </form>

    <twig:Card>
        {% if tickets|length %}
            <twig:Table>
                <twig:Table:Header>
                    <twig:Table:Row>
                        <twig:Table:Head class="pl-4">#</twig:Table:Head>
                        <twig:Table:Head>Sujet</twig:Table:Head>
                        <twig:Table:Head>Catégorie</twig:Table:Head>
                        <twig:Table:Head>Priorité</twig:Table:Head>
                        <twig:Table:Head>Statut</twig:Table:Head>
                        {% if is_agent %}
                            <twig:Table:Head>Client</twig:Table:Head>
                            <twig:Table:Head>Agent</twig:Table:Head>
                        {% endif %}
                        <twig:Table:Head class="pr-4">Créé le</twig:Table:Head>
                    </twig:Table:Row>
                </twig:Table:Header>
                <twig:Table:Body data-tickets>
                    {% for ticket in tickets %}
                        <twig:Table:Row>
                            <twig:Table:Cell class="pl-4 text-muted-foreground">{{ ticket.id }}</twig:Table:Cell>
                            <twig:Table:Cell class="whitespace-normal">
                                <a href="{{ path('ticket_show', {id: ticket.id}) }}" class="font-medium hover:underline">{{ ticket.title }}</a>
                            </twig:Table:Cell>
                            <twig:Table:Cell>{{ ticket.category }}</twig:Table:Cell>
                            <twig:Table:Cell><twig:PriorityBadge :priority="ticket.priority" /></twig:Table:Cell>
                            <twig:Table:Cell><twig:StatusBadge :status="ticket.status" /></twig:Table:Cell>
                            {% if is_agent %}
                                <twig:Table:Cell>{{ ticket.author }}</twig:Table:Cell>
                                <twig:Table:Cell class="text-muted-foreground">{{ ticket.assignee ?? '—' }}</twig:Table:Cell>
                            {% endif %}
                            <twig:Table:Cell class="pr-4 text-muted-foreground">{{ ticket.createdAt|date('d/m/Y H:i') }}</twig:Table:Cell>
                        </twig:Table:Row>
                    {% endfor %}
                </twig:Table:Body>
            </twig:Table>
        {% else %}
            <twig:Empty>
                <twig:Empty:Header>
                    <twig:Empty:Title>Aucun ticket</twig:Empty:Title>
                    <twig:Empty:Description>Aucun ticket ne correspond à ces critères.</twig:Empty:Description>
                </twig:Empty:Header>
                <twig:Button as="a" href="{{ path('ticket_new') }}">Ouvrir un ticket</twig:Button>
            </twig:Empty>
        {% endif %}
    </twig:Card>

    {% if pages > 1 %}
        <twig:Pagination class="mt-4">
            <twig:Pagination:Content>
                {% for p in 1..pages %}
                    <twig:Pagination:Item>
                        <twig:Pagination:Link href="{{ path('ticket_index', query.all|merge({page: p})) }}" :active="p == page">{{ p }}</twig:Pagination:Link>
                    </twig:Pagination:Item>
                {% endfor %}
            </twig:Pagination:Content>
        </twig:Pagination>
    {% endif %}
{% endblock %}
