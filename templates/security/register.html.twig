{% extends 'base.html.twig' %}

{% block title %}Créer un compte · TicketHub{% endblock %}

{% block body %}
    <div class="card auth-card mx-auto shadow-sm">
        <div class="card-body p-4">
            <h1 class="h4 mb-4">Créer un compte</h1>

            {{ form_start(form) }}
                {{ form_row(form.fullName) }}
                {{ form_row(form.email) }}
                {{ form_row(form.plainPassword.first) }}
                {{ form_row(form.plainPassword.second) }}
                <button class="btn btn-dark w-100" type="submit">Créer mon compte</button>
            {{ form_end(form) }}

            <p class="text-center small mt-3 mb-0">
                Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a>
            </p>
        </div>
    </div>
{% endblock %}
