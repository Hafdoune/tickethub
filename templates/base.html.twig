<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}TicketHub{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎫</text></svg>">
        {% block stylesheets %}
            {{ vite_entry_link_tags('app') }}
        {% endblock %}
        {% block javascripts %}
            {{ vite_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body class="min-h-screen bg-muted antialiased">
        <header class="sticky top-0 z-30 border-b bg-background/95 backdrop-blur">
            <div class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4">
                <a href="{{ path('ticket_index') }}" class="flex items-center gap-2 font-semibold">
                    <span class="flex size-7 items-center justify-center rounded-md bg-primary text-xs text-primary-foreground">TH</span>
                    TicketHub
                </a>
                {% if app.user %}
                    {% set route = app.request.attributes.get('_route') %}
                    <nav class="flex items-center gap-4 text-sm">
                        <a href="{{ path('ticket_index') }}" class="{{ route starts with 'ticket_' ? 'text-foreground font-medium' : 'text-muted-foreground hover:text-foreground' }}">Tickets</a>
                        {% if is_granted('ROLE_AGENT') %}
                            <a href="{{ path('dashboard') }}" class="{{ route starts with 'dashboard' ? 'text-foreground font-medium' : 'text-muted-foreground hover:text-foreground' }}">Tableau de bord</a>
                        {% endif %}
                    </nav>
                    <div class="ml-auto flex items-center gap-3">
                        <twig:Button as="a" href="{{ path('ticket_new') }}" size="sm">Nouveau ticket</twig:Button>
                        <span class="hidden text-sm text-muted-foreground md:inline">
                            {{ app.user.fullName }}
                            {% if is_granted('ROLE_AGENT') %}<twig:Badge variant="secondary" class="ml-1">Agent</twig:Badge>{% endif %}
                        </span>
                        <twig:Button as="a" href="{{ path('app_logout') }}" variant="ghost" size="sm">Déconnexion</twig:Button>
                    </div>
                {% endif %}
            </div>
        </header>

        <main class="mx-auto max-w-6xl px-4 py-8">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <twig:Alert variant="{{ type == 'error' ? 'destructive' : 'default' }}" class="mb-6 {{ type == 'success' ? 'border-emerald-200 bg-emerald-50 text-emerald-800' : '' }}" data-flash="{{ type }}">
                        <twig:Alert:Description class="text-current">{{ message }}</twig:Alert:Description>
                    </twig:Alert>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
